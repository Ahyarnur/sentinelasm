# --- Database ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinelasm
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinelasm

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Backend ---
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-long-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Origin yang diizinkan mengakses API (JSON array). Tambahkan URL dashboard.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# true = siapa pun boleh mendaftar. Set false di server publik:
# hanya user pertama (admin) yang bisa didaftarkan lewat /auth/register.
ALLOW_REGISTRATION=false

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Scanning ---
# Batasi concurrency agar tidak membebani target / kena rate limit
SCAN_MAX_CONCURRENCY=10
NUCLEI_SEVERITY=critical,high,medium
PORT_SCAN_TOP=1000
# true = pakai data contoh bila external tool belum terpasang (untuk demo)
# false = gunakan tool asli di image worker (subfinder, naabu, httpx, nuclei, katana, gau, testssl)
MOCK_SCANNERS=false
# Aktifkan scanner agresif (dalfox XSS, sqlmap, ZAP). Butuh izin eksplisit.
ENABLE_ACTIVE_SCANNING=false

# --- Enrichment CVE/EPSS ---
ENABLE_ENRICHMENT=true

# --- Artifacts (laporan) ---
ARTIFACTS_DIR=./artifacts

# --- Skema database ---
# false bila pakai migrasi Alembic (docker compose menjalankan `alembic upgrade head`)
AUTO_CREATE_TABLES=false

# --- API eksternal ---
NVD_API_KEY=

# --- Notifikasi ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@sentinelasm.local
