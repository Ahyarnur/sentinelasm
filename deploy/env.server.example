# SentinelASM — environment untuk server produksi (backend + DB saja).
#
# Salin ke `.env` di root repo pada server, lalu isi nilai rahasia:
#   cp deploy/env.server.example .env
#   # ganti SECRET_KEY & POSTGRES_PASSWORD (lihat `openssl rand -hex 32`)
#
# Jalankan:
#   make up-server        # postgres + redis + backend + worker + beat (tanpa frontend)

# --- Database ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=GANTI-DENGAN-RANDOM-KUAT
POSTGRES_DB=sentinelasm
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sentinel:GANTI-DENGAN-RANDOM-KUAT@localhost:5432/sentinelasm

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Backend ---
BACKEND_PORT=8000
SECRET_KEY=GANTI-DENGAN-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Origin dashboard yang boleh memanggil API (JSON array). WAJIB memuat domain dashboard
# publik, kalau tidak browser memblokir panggilan dari dashboard.
# Contoh: laptop dev + dashboard publik.
CORS_ORIGINS=["https://asm-app.ahyarni.my.id","http://localhost:3000","http://127.0.0.1:3000"]
# WAJIB false di server publik.
ALLOW_REGISTRATION=false

# --- Frontend ---
# Dipakai bila profile compose "web" diaktifkan (dashboard di server/infrastruktur yang sama).
# NEXT_PUBLIC_API_URL di-embed saat BUILD, jadi ubah nilainya → rebuild image frontend.
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://asm.ahyarni.my.id

# --- Scanning ---
SCAN_MAX_CONCURRENCY=5
NUCLEI_SEVERITY=critical,high,medium
PORT_SCAN_TOP=1000
# false = pakai tool asli di image worker; true = data contoh (demo cepat).
MOCK_SCANNERS=false
ENABLE_ACTIVE_SCANNING=false

# --- Enrichment CVE/EPSS ---
ENABLE_ENRICHMENT=true
NVD_API_KEY=

# --- Artifacts (laporan) ---
ARTIFACTS_DIR=./artifacts

# --- Skema database (pakai migrasi Alembic) ---
AUTO_CREATE_TABLES=false

# --- Notifikasi (rencana: Telegram) ---
SLACK_WEBHOOK_URL=
